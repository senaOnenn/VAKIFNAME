# /root/calismalar/api.env (chmod 600). Seçenekler için backend/.env.example.
VAKIFNAME_PUBLIC_CATALOG_FILE=/root/calismalar/data/public_catalog/catalog.json
VAKIFNAME_PROGRESS_DB=/root/calismalar/data/progress.sqlite3
VAKIFNAME_ACCOUNTS_DB=/root/calismalar/data/accounts.sqlite3
VAKIFNAME_STATS_DB=/root/calismalar/data/stats.sqlite3
VAKIFNAME_CONTENT_DIR=/root/calismalar/data/content
VAKIFNAME_CORS_ORIGINS=https://calismalar.tikirsoft.com
VAKIFNAME_COOKIE_SECURE=1
VAKIFNAME_DEMO_API=off
VAKIFNAME_GOOGLE_CLIENT_ID=<istemci-kimliği>.apps.googleusercontent.com
VAKIFNAME_ADMIN_EMAILS=<yönetici e-postaları>
VAKIFNAME_MAIL_BACKEND=off   # SMTP bilgisi gelince smtp
VAKIFNAME_PUBLIC_BASE_URL=https://calismalar.tikirsoft.com
VAKIFNAME_VISIT_SIMULATION=on
VAKIFNAME_GUIDE_MODE=on
VAKIFNAME_GUIDE_PROVIDER=claude-cli
VAKIFNAME_CLAUDE_BIN=/root/.local/bin/claude
VAKIFNAME_GUIDE_BUDGET_DB=/root/calismalar/data/guide-budget.sqlite3
