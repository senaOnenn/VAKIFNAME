# VAKIFNAME backend — örnek ortam değişkenleri (yerel geliştirme).
# Uygulama .env dosyasını kendisi okumaz. Kullanım:  cp .env.example .env  →  set -a; . ./.env; set +a
# .env Git'e girmez (.gitignore). Buraya hiçbir zaman gerçek anahtar, parola veya canlı sunucu yolu yazmayın.

# Kurgusal demo oyun uçları (/places, demo check-in ve pasaport). Oyun geliştirmesi için açın.
VAKIFNAME_DEMO_API=on
# Demo mekânları (varsayılan: data/places.json, kurgusal kayıtlar)
# VAKIFNAME_PLACES_FILE=../data/places.json

# Genel katalog anlık görüntüsü. Boş bırakılırsa katalog boştur. Örnek veri için testlerdeki onaylı anlık görüntü:
VAKIFNAME_PUBLIC_CATALOG_FILE=tests/ask_eval/catalog_snapshot.json

# Gerçek eser pasaportu ilerlemesi (SQLite). Boşsa bellekte tutulur ve yeniden başlatmada silinir.
# VAKIFNAME_PROGRESS_DB=./local-progress.sqlite3

# --- Oyun: ziyaret mührü (Kademe 3; bkz. app/game_routes.py) -------------------------------------------------------
# Ziyaretin kabul edildiği yarıçap (metre), eserin onaylı harita konumuna göre. Katalogda eserin onaylı check-in noktası
# varsa onun noktası ve yarıçapı kullanılır. Geçersiz değer açılışta hata verir.
# VAKIFNAME_VISIT_RADIUS_M=50   # 1..1000 tam sayı; varsayılan 50 (29 Ekim kararı; sahada denenince eser bazında ayar)
# Sunum modu ziyareti (simülasyon; jüri sunumu, evden gösterim): açıkken istemci `simulate: true` gönderip mesafe
# denetimini atlayabilir. Bu mühür `simulated` işaretiyle saklanır ve her yanıtta simülasyon olarak bildirilir (arayüz
# bunu açıkça yazmalı). Canlıda kapalı tutun.
# VAKIFNAME_VISIT_SIMULATION=off   # on | off; varsayılan off

# --- Hesap sistemi (e-posta+parola ve Google ile giriş; bkz. app/auth_routes.py) -----------------------------------
# Hesaplar ve oturumlar (SQLite; parola yalnızca scrypt özeti, oturum belirteci yalnızca SHA-256 özeti olarak saklanır).
# Boşsa bellekte tutulur: yeniden başlatmada bütün hesaplar ve oturumlar silinir. Dosya 0600 izinle açılır.
# VAKIFNAME_ACCOUNTS_DB=./local-accounts.sqlite3
# Oturum çerezinin (vk_session) Secure bayrağı. Boş/tanımsız = otomatik (yalnızca HTTPS isteğinde Secure).
# VAKIFNAME_COOKIE_SECURE=1   # 1 | 0 | boş   (1: her zaman Secure, TLS vekilde/tünelde bitiyorsa; 0: hiçbir zaman, yalnızca yerel http)
# Google ile giriş: Google Cloud'da açılan OAuth istemci kimliği (tür: Web uygulaması, "...apps.googleusercontent.com").
# Gizli değildir ama canlı değer bu dosyaya yazılmaz. Boşsa Google ile giriş kapalıdır (POST /auth/google -> 503).
# VAKIFNAME_GOOGLE_CLIENT_ID=   # boş | <istemci-kimliği>.apps.googleusercontent.com
# /auth/* POST istekleri için sınır, istemci adresine göre: dakika/saat/genel-dakika. Aşılınca 429 + Retry-After.
# VAKIFNAME_AUTH_RATE=10/60/300   # <dakika>/<saat>/<genel-dakika> tam sayılar; varsayılan 10/60/300
# --- Hesap e-postaları: e-posta doğrulama ve parola yenileme (bkz. app/mailer.py) -------------------------------------
# Gönderim yolu. off: e-posta gönderilmez (doğrulama/yenileme bağlantısı kimseye ulaşmaz); file: YALNIZCA geliştirme,
# her e-posta VAKIFNAME_MAIL_DIR altına .eml dosyası olarak yazılır (bağlantıyı oradan açın); smtp: gerçek gönderim.
# VAKIFNAME_MAIL_BACKEND=off   # off | file | smtp; varsayılan off
# VAKIFNAME_MAIL_DIR=./local-mail   # file için klasör (git'e girmez); varsayılan ./local-mail
# Bağlantıların kurulacağı arayüz adresi (sonunda / olmadan). Belirteç adresin #t= parçasında taşınır.
# VAKIFNAME_PUBLIC_BASE_URL=http://localhost:5173   # http://localhost:5173 | https://calismalar.tikirsoft.com
# Bağlantı süreleri: doğrulama saat, parola yenileme dakika (pozitif tam sayı).
# VAKIFNAME_VERIFY_TTL_H=24
# VAKIFNAME_RESET_TTL_MIN=30
# SMTP (yalnızca VAKIFNAME_MAIL_BACKEND=smtp): sunucu, güvenlik, port, kullanıcı, gönderen.
# VAKIFNAME_SMTP_HOST=smtp.ornek.com
# VAKIFNAME_SMTP_SECURITY=starttls   # starttls | ssl; varsayılan starttls
# VAKIFNAME_SMTP_PORT=587            # boşsa starttls -> 587, ssl -> 465
# VAKIFNAME_SMTP_USER=noreply@ornek.com
# VAKIFNAME_MAIL_FROM=VAKIFNAME <noreply@ornek.com>
# Parola asla bu dosyaya yazılmaz; yalnızca sahibinin okuyabildiği dosyanın yolu verilir (önerilen):
# VAKIFNAME_SMTP_PASSWORD_FILE=/yetkili/sunucu/yolu/smtp_password
# Yalnızca dosya kullanılamıyorsa: VAKIFNAME_SMTP_PASSWORD=   (süreç ortamında görünür; önerilmez)
# Not: çerez SameSite=Lax'tır. Arayüz http://localhost:5173 ise API'ye de http://localhost:8000 ile gidin
# (VITE_API_BASE_URL); localhost ile 127.0.0.1 farklı site sayılır ve tarayıcı oturum çerezini göndermez.

# Tarayıcıdan erişim. Tanımlı değilse yerel geliştirme adresleri (localhost/127.0.0.1, 3000 ve 5173) kullanılır.
# VAKIFNAME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Esere Sor: anlamsal arama modeli isteğe bağlıdır; yoksa kelime aramasıyla çalışır.
VAKIFNAME_ASK_ENABLED=on
# VAKIFNAME_ASK_MODEL_DIR=/yerel/model/dizini

# Yapay zekâ rehberi (Nemotron/OpenRouter). Oyun geliştirmesi için KAPALI kalmalı; anahtar gerekmez.
VAKIFNAME_GUIDE_MODE=off
# --- Rehber sağlayıcısı (TEK yerden seçilir; sessiz geçiş yoktur) ---------------------------------------------------
# Giriş/anahtar yoksa başka sağlayıcıya geçilmez: rehber kapanır, kaynaklı arama sürer. Geçersiz ad açılışta hata verir.
# VAKIFNAME_GUIDE_PROVIDER=openrouter   # SEÇENEKLER:
#   openrouter  -> API anahtarı (ücretsiz `:free` modeller; anahtar dosyası aşağıda). VARSAYILAN
#   claude-cli  -> yerel `claude -p`; API değil, claude.ai ABONELİK girişi (`claude auth login` yapılmış olmalı)
#   claude-api  -> (HENÜZ YOK) Anthropic API anahtarı
#   codex       -> (HENÜZ YOK) ChatGPT hesabı, `codex` komutu
#   gemini-cli  -> (HENÜZ YOK) Google hesabı
VAKIFNAME_GUIDE_PROVIDER=openrouter
# Model: boşsa sağlayıcıya göre varsayılan (claude-cli: sonnet). claude-cli için haiku | sonnet | opus.
# VAKIFNAME_GUIDE_MODEL=sonnet
# claude-cli ayarları: düşünme eforu (low|medium|high) ve hesabı seçmek için ayrı yapılandırma klasörü.
# `CLAUDE_CONFIG_DIR=~/.claude-vakifname claude auth login` ile o klasöre giriş yapılır; hangi hesabın kullanıldığı
# açılış logunda yazar ("Rehber sağlayıcısı: ... hesap: ...") ve /guide/status içinde (test modunda) görünür.
# VAKIFNAME_CLAUDE_EFFORT=low
# CLAUDE_CONFIG_DIR=/Users/ben/.claude-vakifname
# --- Yedek (isteğe bağlı; varsayılan none = yedek yok) -----------------------------------------------------------------
# Yalnızca birincil sağlayıcı kullanılamazsa (giriş/anahtar yok, kota, ulaşılamıyor) BURADA YAZILI sağlayıcıya geçer.
# Değerler PROVIDER ile aynı (none | openrouter | claude-cli ...). Yedek model adı sağlayıcıya özgüdür, ayrıca yazılmalı.
# Ücretli bir API'yi yedek yazarsanız harcama o hesaba gider; bilerek yazın.
# VAKIFNAME_GUIDE_FALLBACK=none
# VAKIFNAME_GUIDE_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
# Yerelde /var/lib yazılamaz; bütçe sayaç dosyasını yazılabilir bir yola verin:
# VAKIFNAME_GUIDE_BUDGET_DB=./local-guide-budget.sqlite3
# Anahtar asla bu dosyaya yazılmaz; yalnızca yetkilinin sunucudaki korumalı dosyasının yolu verilir:
# VAKIFNAME_OPENROUTER_KEY_FILE=/yetkili/sunucu/yolu/openrouter_api_key

# --- İstatistik ve yönetim (Faz 6) -----------------------------------------------------------------------------------
# Anonim günlük sayaçların dosyası (boşsa bellekte; yeniden başlatmada silinir). Kişisel veri yazılmaz.
# VAKIFNAME_STATS_DB=./local-stats.sqlite3
# Yönetici e-postaları (virgülle ayrılmış; boşsa yönetici yok). Bu hesaplar /yonetim panelini ve /admin/* uçlarını görür.
# VAKIFNAME_ADMIN_EMAILS=ad.soyad@example.com,ikinci@example.com
