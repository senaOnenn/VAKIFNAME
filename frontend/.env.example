# FastAPI backend adresi (sonunda / olmadan). localhost kullanın: 127.0.0.1 farklı site sayılır, oturum çerezi gönderilmez.
VITE_API_BASE_URL=http://localhost:8000
# Google ile giriş (Google Cloud "VAKIFNAME" projesi > Kimlik bilgileri > OAuth istemci kimliği, tür: Web). Gizli değildir. Boşsa Google girişi kapalıdır.
# VITE_GOOGLE_CLIENT_ID=
